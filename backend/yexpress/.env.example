PORT=5000
NODE_ENV=development

# Comma-separated browser origins for CORS (defaults to FRONTEND_URL or localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

MONGO_URI=
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
REDIS_URL=

# Cloudinary (product / variant images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix in your Cloudinary account
CLOUDINARY_FOLDER=yexpress

# Chapa (https://developer.chapa.co)
CHAPA_SECRET_KEY=
# Default ETB; must match your Chapa dashboard currency
CHAPA_CURRENCY=ETB
# Public URL of this API (for Chapa callback — use ngrok in local dev)
BACKEND_PUBLIC_URL=http://localhost:5000
# Frontend URL for return after payment
FRONTEND_URL=http://localhost:3000
# Optional checkout title shown on Chapa
CHAPA_CHECKOUT_TITLE=YExpress order